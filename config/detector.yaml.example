camera:
  device: "/dev/video0"
  width: 640
  height: 480
  warmup_frames: 5

inference:
  model_path: "/opt/models/efficientdet_lite0.tflite"
  target_fps: 1.5
  score_threshold: 0.5
  category: "person"

debounce:
  enter_seconds: 3.0
  exit_seconds: 3.0

mqtt:
  host: "mosquitto"
  port: 1883
  qos: 2
  topic_event: "presence/event"
  topic_ack: "presence/event/ack"
  client_id_prefix: "presence-detector"

retry:
  initial_delay_seconds: 5
  max_delay_seconds: 600
  multiplier: 3

buffer:
  path: "/var/lib/presence-logger/detector_buf.db"
  max_rows: 100000

# Liveness reporting to the hub (optional; defaults shown). On connect the
# detector publishes "online" (retained) to <status_topic_prefix><device_id> and
# registers an MQTT Last-Will "offline" the broker emits on ungraceful
# disconnect; it also publishes a heartbeat every heartbeat_interval_seconds to
# <heartbeat_topic_prefix><device_id>. keepalive_seconds tunes how fast the
# broker detects a dead TCP connection (~1.5x).
liveness:
  status_topic_prefix: "presence/status/"
  heartbeat_topic_prefix: "presence/heartbeat/"
  heartbeat_interval_seconds: 20
  keepalive_seconds: 30
