mqtt:
  host: "mosquitto"
  port: 1883
  qos: 2
  topic_event: "presence/event"
  topic_ack: "presence/event/ack"
  client_id: "presence-bridge"

oracle:
  connect_timeout_seconds: 10
  query_timeout_seconds: 30
  pool_min: 1
  pool_max: 2
  instant_client_dir: "/opt/oracle/instantclient"

# Used only when a profile sets client_mode: "jdbc". The bridge POSTs each
# MERGE to the oracle-jdbc sidecar container on the docker presence-net.
oracle_jdbc:
  url: "http://oracle-jdbc:8086"
  connect_timeout_ms: 10000
  read_timeout_ms: 30000

network_watcher:
  poll_interval_seconds: 5
  ssid_command: "nmcli -t -f ACTIVE,SSID dev wifi"

time_watcher:
  poll_interval_seconds: 10
  sync_command: "timedatectl show -p NTPSynchronized --value"

retry:
  initial_delay_seconds: 5
  max_delay_seconds: 600
  multiplier: 3

circuit_breaker:
  permanent_ora_codes: [942, 904, 1017, 1031, 12514]
  half_open_after_seconds: 900

buffer:
  path: "/var/lib/presence-logger/bridge_buf.db"
  max_rows: 100000

logging:
  level: "INFO"
  buffer_stats_interval_seconds: 60

# Child-device liveness monitoring (optional; defaults shown). The hub subscribes
# to <status_topic_prefix><device_id> (retained online/offline incl. MQTT
# Last-Will) and <heartbeat_topic_prefix><device_id> (periodic JSON), then logs a
# "liveness" snapshot every report_interval_seconds and a "device_down" warning
# for any device that is offline or whose heartbeat is older than
# heartbeat_timeout_seconds. mqtt_log_path に heartbeat/status/record を
# JSON 1行ずつ残す（10MB×5本でローテ）。キー省略時はこのパス。空文字または
# null なら書かない。相対パスは拒否して bridge.log に warning を出す。
# Oracle 受理済み (inbox status=sent) の record 行は定期削除する。ログ追記は止めない。
liveness:
  status_topic_prefix: "presence/status/"
  heartbeat_topic_prefix: "presence/heartbeat/"
  heartbeat_timeout_seconds: 60
  report_interval_seconds: 30
  mqtt_log_path: "/var/log/presence-logger/child-mqtt.log"

# Child-Pi "record" ingestion (optional; defaults shown). Children publish
# fully-formed Oracle rows (MK_DATE/STA_NO1-3/T1_STATUS) as JSON to `topic`; the
# bridge buffers them durably in buffer_path and MERGEs them to Oracle using the
# row's own values (no ENTER/EXIT mapping). Idempotent via event_id + the MERGE
# key. An ack is published to topic_ack on commit.
record:
  topic: "presence/record"
  topic_ack: "presence/record/ack"
  buffer_path: "/var/lib/presence-logger/bridge_record_buf.db"
